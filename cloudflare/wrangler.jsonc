{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "desafio-guiado-analysis",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "ratelimits": [{
    "name": "ANALYSIS_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 10, "period": 60 }
  }],
  "vars": {
    "ENVIRONMENT": "development",
    "FIREBASE_PROJECT_ID": "gen-lang-client-0622853134",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002"
  },
  "env": {
    "production": {
      "name": "desafio-guiado-analysis-production",
      "ai": { "binding": "AI" },
      "ratelimits": [{
        "name": "ANALYSIS_RATE_LIMITER",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 60 }
      }],
      "vars": {
        "ENVIRONMENT": "production",
        "FIREBASE_PROJECT_ID": "gen-lang-client-0622853134",
        "ALLOWED_ORIGINS": "https://marcosbiao.github.io"
      }
    }
  }
}
